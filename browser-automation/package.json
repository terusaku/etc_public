{
  "name": "browser-automation-cli",
  "version": "1.0.0",
  "description": "Natural language browser automation CLI using Playwright MCP",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "tsx src/index.ts",
    "run": "npm run build && node dist/index.js",
    "auto": "npm run build && node dist/run-automation.js",
    "scrape-zenn": "tsx src/zenn-likes-scraper.ts"
  },
  "bin": {
    "browser-automation": "./dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "@playwright/mcp": "^0.0.28",
    "@playwright/test": "^1.52.0",
    "commander": "^12.0.0",
    "dotenv": "^16.3.1",
    "playwright": "^1.56.1"
  },
  "keywords": [
    "browser",
    "automation",
    "playwright",
    "mcp",
    "cli",
    "@modelcontextprotocol/sdk"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
